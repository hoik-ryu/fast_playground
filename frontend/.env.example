# Vite는 VITE_ 접두사만 클라이언트로 노출합니다.
# 사용법: cp .env.example .env

# 개발 API / 실제 API base URL (Header API mode 토글로 전환, DEV 전용)
VITE_DEV_API_BASE_URL=http://localhost:8000
VITE_REAL_API_BASE_URL=https://api.example.com

# API 요청 timeout (ms). apiClient / refreshClient 공통. 기본 15000
VITE_API_TIMEOUT=15000

# 앱 표시 이름 (Header 브랜드 · document.title · index.html <title>)
VITE_APP_NAME=FastAPI Playground
